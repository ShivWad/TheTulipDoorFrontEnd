generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  password             String
  name                 String?
  phone                String?
  razorpayCustomerId   String?          @unique // Stored Razorpay customer ID
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  isAdmin              Boolean          @default(false)
  addresses            Address[]
  orders          Order[]
  payments        Payment[]
  subscription    Subscription?
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("home")
  fullName  String?
  address   String
  city      String
  state     String
  pincode   String
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                String    // solo, studio, gallery
  price               Int       // in paise ( INR * 100 )
  status              String    @default("pending") // pending, active, paused, cancelled
  razorpaySubId       String?   @unique // razorpay subscription id
  nextBillingDate     DateTime?
  nextDeliveryDate    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  orders              Order[]
}

model Order {
  id                 String        @id @default(cuid())
  userId             String
  subscriptionId     String?
  orderType          String        @default("subscription")
  status             String        @default("pending")
  total              Int
  razorpayOrderId    String?
  razorpayPaymentId  String?
  shiprocketOrderId  String?
  trackingNumber     String?
  deliveryDate       DateTime?
  giftMessage        String?
  giftRecipientName  String?
  giftRecipientPhone String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           Payment[]
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  orderId           String?
  amount            Int
  currency          String   @default("INR")
  status            String
  razorpayPaymentId String?
  razorpayOrderId   String?
  createdAt         DateTime @default(now())
  order             Order?   @relation(fields: [orderId], references: [id])
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  image       String?
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  event     String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SubscriptionPlan {
  id             String   @id @default(cuid())
  planKey        String   @unique
  name           String
  description    String?
  price          Int
  stems          String
  type           String   @default("recurring") // recurring or one_time
  razorpayPlanId String?  @unique // For recurring subscriptions
  razorpayPriceId String?  @unique // For one-time payments
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model OneTimePurchase {
  id                  String    @id @default(cuid())
  userId              String
  planKey             String
  price               Int
  status              String    @default("pending") // pending, completed, cancelled
  razorpayPaymentLinkId String?  @unique // Payment Link ID
  razorpayPaymentId   String?   // Actual payment ID after completion
  nextDeliveryDate    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
}
